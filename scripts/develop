#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Build the panel bundle if it doesn't exist yet
if [[ ! -f "${PWD}/custom_components/magic_lights/panel/magic-lights-panel.js" ]]; then
    "${PWD}/scripts/build-frontend"
fi

# Set the path to custom_components
## This let's us have the structure we want <root>/custom_components/magic_lights
## while at the same time have Home Assistant configuration inside <root>/config
## without resulting to symlinks.
## The repo root (not custom_components itself) must be on PYTHONPATH so that
## HA's loader can `import custom_components` as a package.
export PYTHONPATH="${PYTHONPATH}:${PWD}"

# Start Home Assistant
hass --config "${PWD}/config" --debug

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Home Assistant",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant.__main__",
            "args": [
                "--config",
                "${workspaceFolder}/config",
                "--debug"
            ],
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/custom_components:${env:PYTHONPATH}"
            },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "kill_hass",
            "postDebugTask": "kill_hass"
        }
    ]
}